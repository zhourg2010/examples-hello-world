# nodepipe 配置。复制成 env(去掉 .example)再填真实值。这个文件不进 git。
# 三个平台通用:macOS / Ubuntu / Windows 读的是同一份。
#
# Windows 上路径请用正斜杠或双反斜杠,例如 C:/Users/you/nodepipe

# ---- 必填 ----
# 上游机场订阅地址。多个源用逗号分隔: "https://a,https://b"
SUB_URL="https://your-subscription-url-here"
# Deno 那边的推送地址和密钥(跟 Deno Deploy 环境变量 PUSH_KEY 一致)
PUSH_URL="https://your-domain/push"
PUSH_KEY="your-push-key"

# ---- 选填,都有默认值 ----
# 推送给 Deno 的节点数上限。跟 Deno 端 config.ts 的 NODE_CAP 保持一致。
MAX_NODES="100"
# 凑不够这么多节点就不推送,保住 Deno 上一批(防止推空导致全家断网)
MIN_KEEP="10"
# 美国判定是否严格。1 = GeoIP 库确认是美国才要(默认,推荐);
# 0 = GeoIP 查不到时退回信任 subs-check 打的国家标签。不建议常开 0。
GEOIP_STRICT="1"
# GeoIP 库多少天重新下载一次
# GEOIP_DB_MAX_AGE_DAYS="7"
# 本地"重测名单"文件服务的端口(run_once.py 起,只监听 127.0.0.1)
# RETEST_PORT="8299"
# 单轮 subs-check 的最长运行时间(秒),超时强杀
# RUN_TIMEOUT="2400"
# 整套东西的工作目录。不设就是 ~/nodepipe(Windows 上是 C:\Users\你\nodepipe)
# NODEPIPE_HOME="/home/you/nodepipe"
# 从 GitHub 拉东西走代理时用
GITHUB_PROXY=""

# ---- 另一条数据源:本地 Clash Verge Rev(见 nodepipe/README.md)----
# 平时不用配。想把 Clash 里当下延迟达标的节点直接推出去时,命令行加 SOURCE=clash 即可:
#   SOURCE=clash python3 select_and_push.py
# CLASH_MAX_DELAY="800"      # 延迟阈值(毫秒),超过的不要
# CLASH_TEST_URL="http://www.gstatic.com/generate_204"
# CLASH_TEST_TIMEOUT="5000"  # 单个节点测延迟的超时(毫秒)
# CLASH_CONCURRENCY="16"     # 同时测几个
# CLASH_HOME=""              # Clash Verge Rev 数据目录,装在非默认位置时才需要
# CLASH_PROFILE=""           # 直接指定含 proxies 的 YAML(优先于 CLASH_HOME)
# CLASH_API=""               # 手动指定控制器,如 127.0.0.1:9097
# CLASH_SECRET=""            # 手动指定 secret
