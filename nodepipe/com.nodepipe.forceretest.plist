<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nodepipe.forceretest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/rongins/nodepipe/force_retest.sh</string>
    </array>

    <!-- 4个定点批次:6:00 / 10:30 / 14:30 / 19:00。
         之所以从 subs-check 自己的 cron-expression 挪到这里,是因为 subs-check
         一条 cron 表达式的分钟字段对所有小时统一生效,写不出"有的整点有的30分"这种
         混合模式;拆成4个 launchd 定点任务就没有这个限制。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>10</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>14</integer>
            <key>Minute</key><integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>19</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/rongins/nodepipe/logs/forceretest.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rongins/nodepipe/logs/forceretest.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
