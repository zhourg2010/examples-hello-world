SUB_URL="https://your-subscription-url-here"
PUSH_URL="https://your-domain/push"
PUSH_KEY="your-push-key"
PICK_VLESS="30"
PICK_OTHER="30"
GENERAL_CAP="50"
MIN_KEEP="10"
GITHUB_PROXY=""
# /us 隐藏链接("美国节点组")用,都有默认值,不用特意配置——留着方便以后想调整时知道在哪改。
# US_TOP_N="50"          # 推送给 /us 的节点数上限(按最近一次成功时间排序取前N个)
# US_PING_TIMEOUT="3"    # us_archive.py 做 TCP 连通性探测时,单个节点的超时秒数
export SSL_CERT_FILE=/opt/local/share/curl/curl-ca-bundle.crt
