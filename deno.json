{
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-net --allow-env main.ts",
    "check": "deno check main.ts free/*.ts routes/*.ts",
    "test": "deno test -A"
  },
  // Deno.openKv() 还是 unstable API。写在这儿而不是每条命令后面加 --unstable-kv:
  // 漏加的那条命令(比如 CI 里的 deno test)会在**加载 kv.ts 时**就炸,
  // 报的是 "Deno.openKv is not a function",看不出只是少一个 flag。
  "unstable": ["kv"],

  "imports": {
    "@std/http": "jsr:@std/http@1"
  },
  "lint": {
    "rules": {
      // main.ts / db.ts / free/store.ts 里的 jsr: 内联导入是本仓库既有的写法。
      // 要"修"得把它们挪进上面的 imports 再重新生成 deno.lock —— 那是独立的一件事,
      // 而且改错了会影响线上部署。这里先如实豁免,不拿它当噪音每次红一下。
      "exclude": ["no-import-prefix", "no-unversioned-import"]
    }
  }
}
